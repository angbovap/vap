---
layout: base.njk
---
<section class="hero">
  <div class="hero__media"></div>
  <div class="hero__overlay"></div>
  <div class="hero__fade" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <h1 class="hero__title">
      <span class="hero__mask"><span class="hero__line">Unlocking commercial</span></span>
      <span class="hero__mask"><span class="hero__line">potential to</span></span>
      <span class="hero__mask"><span class="hero__line hero__line--light">future proof value</span></span>
    </h1>
    <span class="hero__mask">
      <span class="hero__line hero__actions">
        <a class="hero__cta hero__cta--primary" href="/what-we-do/">See what we do</a>
        <a class="hero__cta hero__cta--secondary" href="/get-in-touch/">Get in touch <span aria-hidden="true">→</span></a>
      </span>
    </span>
  </div>
</section>

<section class="story">
  <div class="wrap story__grid">
    <div class="story__text story__text--parallax">
      <p class="eyebrow">Our story</p>
      <h2 class="story__lead">Evidence based insights and knowledge to future proof assets, infrastructure, and communities, driving value creation and value protection</h2>
      <p class="story__body">Our purpose is to help decision makers better plan and deliver adaptable places in our cities, regions and rural areas, for today and for a climate resilient future. Value Advisory Partners has over 20 years working across public and private sectors, delivering impact through precinct, development and resilience projects.</p>
      <div class="story__stat">
        <span class="story__stat-number">20+ Years</span>
        <span class="story__stat-label">working across public and private sectors</span>
      </div>
      <a class="section-cta" href="/what-we-do/">See how we work <span aria-hidden="true">→</span></a>
    </div>
    <div class="story__media story__media--parallax" style="background-image: url('/assets/img/site/our-story.jpg');"></div>
  </div>
</section>

<section class="focus">
  <div class="wrap">
    <div class="section-head reveal focus__head">
      <p class="eyebrow">Our focus</p>
      <h2>Our three areas of commercial intelligence</h2>
    </div>
  </div>

  <div class="focus__grid-outer">
    <div class="focus__grid stagger">
      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/site/resilience.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Resilience and Disaster Risk Reduction</h3>
          <p class="focus__text">With CSIRO, developed the Enabling Resilience Investment Framework, an assessment and decision-making toolkit for reducing climate and disaster risk.</p>
          <a class="focus__more" href="/what-we-do/resilience/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/site/precincts.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Precincts, Planning and Development</h3>
          <p class="focus__text">Success depends on an evidence base integrating top-down and bottom-up analysis, real data and forecasts.</p>
          <a class="focus__more" href="/what-we-do/precincts/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/site/infrastructure.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Infrastructure, Amenity and Land Use</h3>
          <p class="focus__text">A system helping governments, agencies, universities and developers integrate transport, land use and delivery models.</p>
          <a class="focus__more" href="/what-we-do/infrastructure/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="capabilities">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Capabilities and industries</p>
      <h2>What can we help with, and who do we work with?</h2>
    </div>

    <div class="capabilities__panel reveal">
      <div class="capabilities__grid">
        <div class="capabilities__col">
          <h3>What we do</h3>
          <ul class="stagger">
            <li>Commercial Feasibility</li>
            <li>Resilience Investment</li>
            <li>Infrastructure Assessments</li>
            <li>Forecasting and Modelling</li>
            <li>Economic Impact Assessment (EIA)</li>
            <li>Land Use Change & Development</li>
            <li>Project Funding and Value Capture Mechanisms</li>
            <li>Dynamic Delivery Models </li>
            <li>Stakeholder Engagement</li>
            <li>Geospatial Analysis (GIS)</li>
          </ul>
        </div>
        <div class="capabilities__col">
          <h3>Who we work with</h3>
          <ul class="stagger">
            <li>Governments (Local, State and Commonwealth)</li>
            <li>Government Agencies (incl. Resilience and Economic Development)</li>
            <li>Residential and Housing Development</li>
            <li>Commercial and Industrial Development</li>
            <li>First Nations and Traditional Owners Corporations (TOCs)</li>
            <li>Tourism and Visitor Economy</li>
            <li>Institutional</li>
            <li>Transport</li>
            <li>Ports and Aviation</li>
            <li>Communications and Utilities</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="values">
  <div class="wrap values__grid reveal">
    <div class="values__lead-col">
      <p class="eyebrow">Our values</p>
      <h2 class="values__lead">Collaboration and co-design with every client</h2>
      <div class="values__body">
        <p>At Value Advisory Partners we have a clear purpose and focus to maximise and sustain the value that can be obtained by public and private sector clients from their investments.</p>
        <p>We do this through a structured approach using data and evidence to build knowledge to inform sound decision making. We understand that value comes from multiple sources which can be integrated together to build a complete picture of the system to enable optimal value realisation and return.</p>
        <p>The hallmark of our work and approach is collaboration and co-design with our clients to identify, maximise and sustain the opportunities to create and extract value from their investments.</p>
      </div>
    </div>
    <div class="values__right">
      <div class="values__list stagger">
        <div class="values__item reveal">
          <div class="values__item-image" style="background-image: url('/assets/img/site/conference1.jpg');"></div>
          <div class="values__item-body">
            <span class="values__num" aria-hidden="true">01</span>
            <p>Creating and maintaining ongoing relationships built on trust</p>
          </div>
        </div>
        <div class="values__item reveal">
          <div class="values__item-image" style="background-image: url('/assets/img/site/conference2.jpg');"></div>
          <div class="values__item-body">
            <span class="values__num" aria-hidden="true">02</span>
            <p>Empowering clients to find new solutions they hadn't considered</p>
          </div>
        </div>
        <div class="values__item reveal">
          <div class="values__item-image" style="background-image: url('/assets/img/site/innovativesolutions.jpg');"></div>
          <div class="values__item-body">
            <span class="values__num" aria-hidden="true">03</span>
            <p>Designing innovative solutions</p>
          </div>
        </div>
        <div class="values__item reveal">
          <div class="values__item-image" style="background-image: url('/assets/img/site/conference4.jpg');"></div>
          <div class="values__item-body">
            <span class="values__num" aria-hidden="true">04</span>
            <p>Enhancing benefits to the community and society</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trusted">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Where we work</p>
      <h2>Trusted across resilience investment, precinct developments and infrastructure projects</h2>
      <p class="trusted__intro">Project experience across resilience, precincts and infrastructure, throughout Australia and New Zealand.</p>
    </div>

    <div class="trusted__map-panel reveal">
      <div class="trusted__map-embed" data-project-map>
        <iframe
          src="https://www.google.com/maps?ll=-29,150&z=4&output=embed"
          title="Map of Australia and New Zealand"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          tabindex="-1"></iframe>
        <div class="trusted__map-block" aria-hidden="true"></div>
        <p class="trusted__map-cover" aria-hidden="true">Australia and New Zealand</p>

        {% for region in projectMap.regions %}
        <div class="trusted__map-marker" style="left: {{ region.x }}%; top: {{ region.y }}%;">
          <button class="trusted__pin" type="button" data-map-pin aria-expanded="false" aria-controls="pin-panel-{{ region.id }}">
            <span class="visually-hidden">{{ region.label }}, </span>{{ region.projects.length }}
          </button>
          <div class="trusted__pin-panel" id="pin-panel-{{ region.id }}" data-map-panel hidden>
            <h3>{{ region.label }}</h3>
            <ul>
              {% for project in region.projects %}
              <li>
                <span class="trusted__pin-project">{{ project.name }}</span>
                <span class="trusted__pin-tags">
                  {% for area in project.areas %}<span class="trusted__pin-tag" data-area="{{ area | lower }}">{{ area }}</span>{% endfor %}
                </span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        {% endfor %}

        <div class="trusted__map-marker trusted__map-marker--national" style="left: 19%; top: 8%;">
          <button class="trusted__pin trusted__pin--national" type="button" data-map-pin aria-expanded="false" aria-controls="pin-panel-national">
            <span class="visually-hidden">National projects, </span>{{ projectMap.nationalProjects.length }}
          </button>
          <div class="trusted__pin-panel trusted__pin-panel--national" id="pin-panel-national" data-map-panel hidden>
            <h3>National projects</h3>
            <ul>
              {% for project in projectMap.nationalProjects %}
              <li>
                <span class="trusted__pin-project">{{ project.name }}</span>
                <span class="trusted__pin-tags">
                  {% for area in project.areas %}<span class="trusted__pin-tag" data-area="{{ area | lower }}">{{ area }}</span>{% endfor %}
                </span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="trusted__areas stagger">
      {% set areaCards = [
        { area: "resilience", href: "/what-we-do/resilience/", label: "Resilience and Disaster Risk Reduction", clients: areaClients.resilience },
        { area: "precincts", href: "/what-we-do/precincts/", label: "Precincts, Planning and Development", clients: areaClients.precincts },
        { area: "infrastructure", href: "/what-we-do/infrastructure/", label: "Infrastructure, Amenity and Land Use", clients: areaClients.infrastructure }
      ] %}
      {% for card in areaCards %}
      <a class="trusted__area trusted__area--list reveal" data-area="{{ card.area }}" href="{{ card.href }}">
        <span class="trusted__area-label">{{ card.label }}</span>
        <span class="trusted__area-clients" data-client-rotator aria-live="polite">
          {% for client in card.clients %}
          <span class="trusted__area-client{% if loop.first %} is-active{% endif %}">
            {% if client.logo %}
            <img class="trusted__area-client-logo" src="{{ client.logo }}" alt="">
            {% else %}
            <span class="trusted__area-client-mark" aria-hidden="true">{{ client.name[0] }}</span>
            {% endif %}
            <span class="trusted__area-client-name">{{ client.name }}</span>
          </span>
          {% endfor %}
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="approach">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Our approach</p>
      <h2>Practical tools that turn analysis into decisions.</h2>
    </div>

    <div class="approach__diagram reveal">
      <div class="approach__mosaic" role="img" aria-label="Diagram: Practical tools to deliver integrated and optimised outcomes, made up of four connected approaches - 01 Joined-up thinking, 02 Rapid assessment, 03 Top-down bottom-up, 04 Agile decision tools.">
        <span class="approach__tile approach__tile--1"></span>
        <span class="approach__tile approach__tile--2"></span>
        <span class="approach__tile approach__tile--3"></span>
        <span class="approach__tile approach__tile--4"></span>
      </div>

      <div class="visually-hidden">
        <h3>01: Joined-up thinking</h3>
        <p>Connect and integrate data and analysis - upstream and downstream - to understand the lifecycle of planning and delivering the infrastructure, amenity, and services for our cities and places</p>
        <h3>02: Rapid assessment</h3>
        <p>Early stage assessment of project value and benefits to provide an immediate, order of magnitude guide for a range of options</p>
        <h3>03: Top-down, bottom-up</h3>
        <p>Integrate real data and projections/forecasts to bring together a macro view of "the vision" and the micro view of what's on the ground. Make sense of these top-down and bottom-up analyses to assess both strategic and place-based contexts.</p>
        <h3>04: Agile decision tools</h3>
        <p>Using agile visualisation technology to allow decision makers to develop and prioritise options, challenge assumptions, test scenarios, and optimise outcomes</p>
      </div>
    </div>

    <a class="section-cta approach__cta" href="/what-we-do/">Explore what we do <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="work">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Selected work</p>
      <h2>From flood modelling to station precincts.</h2>
    </div>

    <div class="work__grid stagger">
      <a class="work__item work__item--featured" href="/our-work/gawler-river-flood-management/">
        <div class="work__media reveal reveal-converge--media" style="background-image: url('/assets/img/case-studies/gawler/gawler2.jpg');"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Gawler River Flood Management</h3>
          <p class="work__client">Department of Environment and Water SA</p>
          <p>Economic assessment of flood mitigation options along the Gawler River, integrating flood modelling with impact analysis for dwellings, businesses and farms under a climate change scenario.</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a class="work__item" href="/our-work/greenline-city-of-melbourne/">
        <div class="work__media reveal reveal-converge--media" style="background-image: url('/assets/img/case-studies/greenline/greenline-2.jpg');"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Greenline</h3>
          <p class="work__client">City of Melbourne</p>
          <p>Economic impact assessment and funding plan for the Greenline Implementation Plan, assessing benefits and constraints for local businesses, residents and visitors along the Yarra River corridor.</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a class="work__item work__item--wide" href="/our-work/deakin-burwood-srl-station/">
        <div class="work__media reveal reveal-converge--media" style="background-image: url('/assets/img/case-studies/deakin/deakin1.jpg');"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Deakin Burwood SRL Station Assessment</h3>
          <p>Evaluation of station location options using the VITAL system, comparing integrated and non-integrated precinct approaches under different scenarios.</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>

    <a class="section-cta" href="/our-work/">See all our work <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="testimonial">
 <div class="testimonial__stack">
  <div class="wrap logos__inner reveal">
    <div class="logos__head">
      <h2>Trusted by agencies, institutions and industry across Australia</h2>
    </div>
    <div class="logos__row">
      <div class="logos__track">
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/clients/csiro-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">CSIRO</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/clients/uom-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">University of Melbourne</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/clients/vhba-logo.png" alt="" aria-hidden="true">
          <span class="logos__name">Victorian Health Building Authority</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/clients/vt-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">Victoria Department of Transport and Planning</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/clients/udia-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">UDIA</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/clients/csiro-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">CSIRO</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/clients/uom-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">University of Melbourne</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/clients/vhba-logo.png" alt="" aria-hidden="true">
          <span class="logos__name">Victorian Health Building Authority</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/clients/vt-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">Victoria Department of Transport and Planning</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/clients/udia-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">UDIA</span>
        </div>
      </div>
    </div>
  </div>

  <div class="testimonial__divider" aria-hidden="true"></div>

  <div class="wrap testimonial__grid">
    <div class="testimonial__lead-col reveal reveal-converge--left">
      <p class="testimonial__mark" aria-hidden="true">&ldquo;</p>
    </div>

    <div class="carousel reveal reveal-converge--right" data-carousel>
      <div class="carousel__viewport">
        <div class="carousel__track">
          {% for t in testimonials %}
          <blockquote class="carousel__slide{% if loop.first %} is-active{% endif %}" data-slide{% if not loop.first %} aria-hidden="true"{% endif %}>
            <p class="carousel__quote">{{ t.quote }}</p>
            <footer class="testimonial__attribution">
              {% if t.attribution == "CEO in Tourism" %}
              <span class="testimonial__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="8.5" r="4" fill="currentColor"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" fill="currentColor"/></svg>
              </span>
              {% endif %}
              <span>{{ t.attribution }}</span>
            </footer>
          </blockquote>
          {% endfor %}
        </div>
        <div class="visually-hidden" aria-live="polite" data-carousel-announcer></div>
      </div>

      {% if testimonials.length > 1 %}
      <div class="carousel__progress" role="tablist" aria-label="Testimonial navigation">
        {% for t in testimonials %}
        <button class="carousel__segment{% if loop.first %} is-active{% endif %}" type="button" role="tab" aria-label="Show testimonial {{ loop.index }}: {{ t.attribution }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
          <span class="carousel__segment-track" aria-hidden="true"><span class="carousel__segment-fill"></span></span>
          <span class="carousel__segment-label">{{ t.attribution }}</span>
        </button>
        {% endfor %}
      </div>
      {% endif %}

      <a class="section-cta" href="/our-work/">Read more client stories <span aria-hidden="true">→</span></a>
    </div>
  </div>
 </div>
</section>

<section class="cta">
  <div class="wrap cta__inner reveal">
    <div class="cta__text">
      <h2>Connect with us</h2>
      <p>Phone: {{ site.phone }}<br>Email: {{ site.email }}</p>
    </div>
    <a class="cta__link" href="/get-in-touch/">Get in touch <span aria-hidden="true">→</span></a>
  </div>
</section>
