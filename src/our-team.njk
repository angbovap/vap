---
layout: base.njk
permalink: /our-team/
title: Our team
---
{% from "partials/icons.njk" import render as icon %}
<section class="team-intro">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Our team</p>
      <h1>The people behind the work</h1>
    </div>
    <p class="team-intro__text reveal">Value Advisory Partners has a team of exceptional and results-driven leaders who love to work with our growing clientele. Our team is eager to learn, open to new ideas and technologies and adaptable to the fast-changing and increasingly complex business environment. Meet everyone below.</p>
  </div>
</section>

<section class="team">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Core team</p>
      <h2>Meet the team</h2>
    </div>
    <div class="team__grid">
      {% for member in team %}
      <a class="team-member" href="{{ member.url }}">
        <div class="team-member__portrait{% if not member.image %} team-member__portrait--placeholder{% endif %}"{% if member.image %} style="background-image: url('{{ member.image }}');"{% else %} data-placeholder="Portrait to come"{% endif %}></div>
        <div class="team-member__info">
          <h3 class="team-member__name">{{ member.name }}</h3>
          {% if member.role %}<p class="team-member__role">{{ member.role }}</p>{% endif %}
          <span class="team-member__link">View profile <span aria-hidden="true">→</span></span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="associates">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Extending our expertise</p>
      <h2>Specialists we call on when a project needs them</h2>
    </div>
    <div class="associates-spotlight" data-associates-spotlight>
      <ul class="associates-spotlight__toc" role="tablist" aria-label="Extending our expertise">
        {% for person in associates %}
        <li>
          <button type="button" class="associates-spotlight__toc-item{% if loop.first %} is-active{% endif %}" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" data-associates-tab="{{ loop.index0 }}">
            {% if person.image %}
            <span class="associates-spotlight__toc-avatar" style="background-image: url('{{ person.image }}');"></span>
            {% else %}
            <span class="associates-spotlight__toc-avatar associates-spotlight__toc-avatar--placeholder" aria-hidden="true">{{ person.name[0] }}</span>
            {% endif %}
            <span class="associates-spotlight__toc-text">
              <span class="associates-spotlight__toc-name">{{ person.name }}</span>
            </span>
          </button>
        </li>
        {% endfor %}
      </ul>
      <div class="associates-spotlight__panels">
        {% for person in associates %}
        <div class="associates-spotlight__panel{% if loop.first %} is-active{% endif %}" data-associates-panel="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
          {% if person.image %}
          <div class="associates-spotlight__avatar" style="background-image: url('{{ person.image }}');"></div>
          {% else %}
          <div class="associates-spotlight__avatar associates-spotlight__avatar--placeholder" aria-hidden="true">{{ person.name[0] }}</div>
          {% endif %}
          <div class="associates-spotlight__body">
            <h3 class="associates-spotlight__name">{{ person.name }}</h3>
            {% if person.experience %}<p class="associates-spotlight__experience">{{ person.experience }}</p>{% endif %}
            {% if person.description %}
            <p class="associates-spotlight__text">{{ person.description }}</p>
            {% else %}
            <p class="associates-spotlight__text associates-spotlight__text--placeholder">[no desc]</p>
            {% endif %}
            {% if person.expertise and person.expertise.length %}
            <ul class="associates-spotlight__tags">
              {% for e in person.expertise %}
              {% set area = 'resilience' if 'Resilience' in e else ('precincts' if 'Precincts' in e else ('infrastructure' if 'Infrastructure' in e else '')) %}
              <li{% if area %} data-area="{{ area }}"{% endif %}>{{ e }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            {% if person.services and person.services.length %}
            <div class="associates-spotlight__services">
              <p class="associates-spotlight__services-label">Services</p>
              <div class="associates-spotlight__services-grid">
                {% for group in person.services %}
                <div class="associates-spotlight__service-group">
                  <h4>{{ group.title }}</h4>
                  <ul>{% for item in group.items %}<li>{{ item }}</li>{% endfor %}</ul>
                </div>
                {% endfor %}
              </div>
            </div>
            {% endif %}
            {% if person.qualifications and person.qualifications.length %}
            <ul class="associates-spotlight__quals">
              {% for q in person.qualifications %}<li>{{ q }}</li>{% endfor %}
            </ul>
            {% endif %}
            {% if person.location or person.phone %}
            <p class="associates-spotlight__meta">
              {% if person.location %}{{ person.location }}{% endif %}{% if person.location and person.phone %} · {% endif %}{% if person.phone %}<a href="tel:{{ person.phone }}">{{ person.phone }}</a>{% endif %}
            </p>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="partners">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Collaboration partners</p>
      <h2>Working alongside leading research institutions</h2>
    </div>
    <div class="partners__grid">
      {% for partner in partners %}
      <div class="partner-card">
        {% if partner.icon %}<span class="partner-card__icon">{{ icon(partner.icon) }}</span>{% endif %}
        {% if partner.url %}
        <h3 class="partner-card__name"><a href="{{ partner.url }}" target="_blank" rel="noopener">{{ partner.name }}</a></h3>
        {% else %}
        <h3 class="partner-card__name">{{ partner.name }}</h3>
        {% endif %}
        {% if partner.institution %}<p class="partner-card__institution">{{ partner.institution }}</p>{% endif %}
        {% if partner.description %}
        <p class="partner-card__text">{{ partner.description }}</p>
        {% else %}
        <p class="partner-card__text partner-card__text--placeholder">[no desc]</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap cta__inner reveal">
    <div class="cta__text">
      <h2>Connect with us</h2>
      <p>Phone: {{ site.phone }}<br>Email: {{ site.email }}</p>
    </div>
    <a class="cta__link" href="/get-in-touch/">Get in touch <span aria-hidden="true">→</span></a>
  </div>
</section>
