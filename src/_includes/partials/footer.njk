<footer class="site-foot">
  <div class="wrap site-foot__inner">
    <div class="site-foot__brand">
      <p class="site-foot__name">{{ site.brandPrimary }} <span>{{ site.brandSecondary }}</span></p>
      <p class="site-foot__tagline">{{ site.tagline }}</p>
    </div>

    <div class="site-foot__cols">
      <div class="site-foot__col">
        <p class="site-foot__label">Contact</p>
        <ul class="site-foot__list">
          <li><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.linkedin }}">LinkedIn</a></li>
        </ul>
      </div>

      {% for office in site.offices %}
      <div class="site-foot__col">
        <p class="site-foot__label">{{ office.name }}</p>
        <address class="site-foot__address">
          {{ office.line1 }}<br>
          {{ office.line2 }}
        </address>
        <a class="site-foot__directions" href="https://www.google.com/maps/search/?api=1&amp;query={{ (office.line1 + ', ' + office.line2) | urlencode }}" target="_blank" rel="noopener">Get directions <span aria-hidden="true">→</span></a>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="wrap site-foot__mapwrap" data-foot-map>
    <div class="site-foot__tabs" role="group" aria-label="Choose an office to show on the map">
      {% for office in site.offices %}
      <button type="button" class="site-foot__tab{% if loop.first %} is-active{% endif %}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"
        data-map-src="https://www.google.com/maps?q={{ (office.line1 + ', ' + office.line2) | urlencode }}&amp;output=embed"
        data-map-title="Map showing the {{ office.name }} office of {{ site.name }} at {{ office.line1 }}">{{ office.name }}</button>
      {% endfor %}
    </div>
    <div class="site-foot__map">
      {% set first = site.offices[0] %}
      <iframe
        src="https://www.google.com/maps?q={{ (first.line1 + ', ' + first.line2) | urlencode }}&output=embed"
        width="100%" height="100%" style="border:0;" loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing the {{ first.name }} office of {{ site.name }} at {{ first.line1 }}"></iframe>
    </div>
  </div>

  <div class="site-foot__bar">
    <div class="wrap">
      <p class="site-foot__legal-text">&copy; {% year %} {{ site.legalName }} All rights reserved.
         <a href="/copyright/">Copyright and terms</a></p>
    </div>
  </div>
</footer>
