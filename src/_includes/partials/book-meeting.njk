{#
  Booking band shown above the footer on every page except /book/. Puts the
  person most relevant to the current page first. Host details and links come
  from src/_data/booking.json (see the bookHost filter in .eleventy.js).
#}
{% set featured = page.url | featuredHost(services, member.slug) %}
<section class="book" id="book-meeting" aria-labelledby="book-heading">
  <div class="wrap book__layout">
    <div class="book__intro reveal">
      <p class="eyebrow">Book a meeting</p>
      <h2 id="book-heading">Speak with the right adviser.</h2>
      <p class="book__lede">Pick the adviser closest to your question and choose a time in their calendar.</p>
      <div class="book__reach-slot book__reach-slot--side">{% include "partials/book-reach.njk" %}</div>
    </div>

    {% include "partials/book-advisers.njk" %}

    <div class="book__reach-slot book__reach-slot--below">{% include "partials/book-reach.njk" %}</div>
  </div>
</section>
