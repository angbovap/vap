<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="site-head__inner">
    <a class="brand" href="/">
      <img class="brand__mark" src="/assets/img/brand/vaplogo.png" alt="" width="56" height="56">
      <span class="brand__text">
        <span class="brand__name"><span class="brand__name-primary">{{ site.brandPrimary }}</span> <span class="brand__name-secondary">{{ site.brandSecondary }}</span></span>
        <span class="brand__tagline">{{ site.tagline }}</span>
      </span>
    </a>

    <a
      class="nav-book"
      target="_blank"
      rel="noopener"
      {% if site.bookingEmbedUrl %}
      href="{{ site.bookingEmbedUrl }}"
      {% else %}
      href="https://calendar.google.com/calendar/render?action=TEMPLATE&text={{ ('Meeting with ' + site.name) | urlencode }}&details={{ ('Meeting request from the ' + site.name + ' website.') | urlencode }}&add={{ site.bookingHost.email | urlencode }}"
      {% endif %}
    ><span class="nav-book__full">Book a meeting</span><span class="nav-book__short">Book</span></a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav">
      <span class="visually-hidden">Menu</span>
      <svg width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"
        stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </button>

    <nav id="nav" class="nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
        <li class="nav__item{% if item.children %} nav__item--has-children{% endif %}">
          <a href="{{ item.url }}"
             {% if (item.url == "/" and page.url == "/") or (item.url != "/" and page.url.startsWith(item.url)) %}aria-current="page"{% endif %}>
            {{ item.label }}
            {% if item.children %}<span class="nav__caret" aria-hidden="true"></span>{% endif %}
          </a>
          {% if item.children %}
          <ul class="nav__submenu">
            {% for child in item.children %}
            <li>
              <a href="{{ child.url }}" {% if page.url == child.url %}aria-current="page"{% endif %}>{{ child.label }}</a>
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>