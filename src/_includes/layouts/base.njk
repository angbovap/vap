<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}VAP · {{ title }}{% else %}{{ site.name }}{% endif %}</title>
  {% set pageDescription = description or seo[page.url].description %}
  {% if pageDescription %}<meta name="description" content="{{ pageDescription }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}VAP · {{ title }}{% else %}{{ site.name }}{% endif %}">
  {% if pageDescription %}<meta property="og:description" content="{{ pageDescription }}">{% endif %}
  <meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ site.siteUrl }}/assets/img/site/hero.jpg">
  {% if site.gaMeasurementId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.gaMeasurementId }}');
  </script>
  {% endif %}
  <link rel="icon" href="/assets/img/brand/vaplogo.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/brand/vaplogo.png">
  {% if page.url == "/" %}<link rel="preload" href="/assets/img/site/hero.webp" as="image" type="image/webp" fetchpriority="high">{% endif %}
  <style>
    @font-face{font-family:'Fraunces';font-style:italic;font-weight:400 500;font-display:swap;src:url(/assets/fonts/fraunces-italic-latin.woff2) format('woff2')}
  </style>
  <link rel="stylesheet" href="/styles/tokens.css">
  <link rel="stylesheet" href="/styles/base.css">
  {% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.name }}",
    "url": "{{ site.siteUrl }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "sameAs": ["{{ site.linkedin }}"],
    "potentialAction": {
      "@type": "ReserveAction",
      "name": "Book a meeting",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ site.siteUrl }}/book/",
        "actionPlatform": ["http://schema.org/DesktopWebPlatform", "http://schema.org/MobileWebPlatform"]
      }
    },
    "address": [
      {% for office in site.offices %}{
        "@type": "PostalAddress",
        "streetAddress": "{{ office.line1 }}",
        "addressLocality": "{{ office.locality }}",
        "addressRegion": "{{ office.region }}",
        "postalCode": "{{ office.postalCode }}",
        "addressCountry": "AU"
      }{% if not loop.last %},{% endif %}{% endfor %}
    ]
  }
  </script>
</head>
<body>
  {% if not bare %}{% include "partials/nav.njk" %}{% endif %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% if not bare and page.url != "/404.html" and page.url != "/book/" and page.url != "/connect/" and not page.url.startsWith("/our-work/") and not page.url.startsWith("/our-team/") %}{% include "partials/book-meeting.njk" %}{% endif %}

  {% if not bare %}{% include "partials/footer.njk" %}{% endif %}

  {% if not bare %}
  <button class="back-to-top" type="button" data-back-to-top>
    <span aria-hidden="true">↑</span>
    <span class="visually-hidden">Back to top</span>
  </button>
  {% endif %}

  <script src="/scripts/analytics.js" defer></script>
  <script src="/scripts/footer-map.js" defer></script>
  <script src="/scripts/mobile-nav.js" defer></script>
  <script src="/scripts/reveal.js" defer></script>
  <script src="/scripts/carousel.js" defer></script>
  <script src="/scripts/hero-parallax.js" defer></script>
  <script src="/scripts/work-list-preview.js" defer></script>
  <script src="/scripts/case-panels.js" defer></script>
  <script src="/scripts/associates-spotlight.js" defer></script>
  <script src="/scripts/wwd-selector.js" defer></script>
  <script src="/scripts/back-to-top.js" defer></script>
  <script src="/scripts/contact-form.js" defer></script>
  <script src="/scripts/project-map.js" defer></script>
  <script src="/scripts/client-rotator.js" defer></script>
  <script src="/scripts/youtube-preview.js" defer></script>
  <script src="/scripts/publications-index.js" defer></script>
</body>
</html>
