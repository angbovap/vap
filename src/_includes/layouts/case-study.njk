---
layout: base.njk
---
<section class="case-hero">
  <div class="case-hero__media"{% if image %} style="background-image: url('{{ image }}');{% if imagePosition %} background-position: {{ imagePosition }};{% endif %}"{% else %} data-placeholder="Image to come"{% endif %}></div>
  <div class="case-hero__overlay"></div>
  <div class="wrap case-hero__back-row">
    <a class="case-hero__back" href="/our-work/"><span aria-hidden="true">←</span> Our work</a>
  </div>
  <div class="wrap case-hero__inner">
    <p class="eyebrow">Selected work</p>
    <h1 class="case-hero__title">{{ title }}</h1>
    {% if client %}<p class="case-hero__client">{{ client }}</p>{% endif %}
    {% if sections %}<p class="case-hero__note" data-case-hero-note hidden></p>{% endif %}
  </div>
</section>

{% if lead %}
<section class="case-lead">
  <div class="wrap reveal">
    <p class="case-lead__text">{{ lead }}</p>
  </div>
</section>
{% endif %}

<section class="case-meta">
  <div class="wrap case-meta__panel reveal">
    <div class="case-meta__grid">
      {% if placeContext %}
      <div class="case-meta__item">
        <span class="case-meta__label">Place context</span>
        <span class="case-meta__value">{{ placeContext }}</span>
      </div>
      {% endif %}
      {% if projectType %}
      <div class="case-meta__item">
        <span class="case-meta__label">Project type</span>
        <span class="case-meta__value">{{ projectType }}</span>
      </div>
      {% endif %}
      {% if lifecycle %}
      <div class="case-meta__item">
        <span class="case-meta__label">Project lifecycle</span>
        <span class="case-meta__value">{{ lifecycle }}</span>
      </div>
      {% endif %}
      {% if duration %}
      <div class="case-meta__item">
        <span class="case-meta__label">Project duration</span>
        <span class="case-meta__value">{{ duration }}</span>
      </div>
      {% endif %}
      {% if scope %}
      <div class="case-meta__item">
        <span class="case-meta__label">Scope</span>
        <span class="case-meta__value">{{ scope }}</span>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if content and content | trim | length > 0 %}
<section class="case-intro-image">
  <div class="wrap reveal">
    {{ content | safe }}
  </div>
</section>
{% endif %}

{% if sections %}
<section class="case-body">
  <div class="wrap reveal">
    <div class="case-panels" data-case-panels>
      <div class="case-panels__tabs" role="tablist" aria-label="Sections of this case study">
        {% for section in sections %}
        {% set imgSrc = section.image or section.diagram %}
        {% set isContain = (not section.image) and section.diagram %}
        <button class="case-panels__tab{% if loop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" data-case-tab="{{ loop.index0 }}"{% if imgSrc %} data-case-image="{{ imgSrc }}" data-case-image-position="{{ section.imagePosition | default('center') }}"{% if isContain %} data-case-image-contain="true"{% endif %}{% endif %}{% if section.heroNote %} data-hero-note="{{ section.heroNote }}"{% endif %}>
          <span class="case-panels__tab-index">0{{ loop.index }}</span>
          <span class="case-panels__tab-label">{{ section.heading }}</span>
        </button>
        {% endfor %}
      </div>

      <div class="case-panels__panels">
        {% for section in sections %}
        <div class="case-panels__panel{% if loop.first %} is-active{% endif %}" data-case-panel="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
          <h3>{{ section.heading }}</h3>
          <p class="case-panels__body">{{ section.body }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if presentationPdf %}
<section class="case-presentation">
  <div class="wrap reveal">
    <a class="case-presentation__card" href="{{ presentationPdf }}" target="_blank" rel="noopener">
      <span class="case-presentation__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
      </span>
      <span class="case-presentation__text">
        <span class="case-presentation__label">Presentation</span>
        <span class="case-presentation__title">{{ presentationTitle | default("Conference presentation") }}</span>
      </span>
      <span class="case-presentation__link">View PDF <span aria-hidden="true">→</span></span>
    </a>
  </div>
</section>
{% endif %}

<section class="case-related">
  <div class="wrap">
    <p class="eyebrow">Continue exploring</p>
    <div class="case-related__grid stagger">
      {% for study in collections.caseStudies %}
        {% if study.data.title != title %}
        <a class="case-related__item reveal" href="{{ study.url }}">
          <div class="case-related__media"{% if study.data.image %} style="background-image: url('{{ study.data.image }}');"{% else %} data-placeholder="Image to come"{% endif %}></div>
          <h3>{{ study.data.title }}</h3>
          {% if study.data.client %}<p class="work__client">{{ study.data.client }}</p>{% endif %}
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </a>
        {% endif %}
      {% endfor %}
    </div>

    <a class="section-cta" href="/our-work/">Back to selected work <span aria-hidden="true">→</span></a>
  </div>
</section>
