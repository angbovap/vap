---
layout: base.njk
extraCss: /styles/connect.css
permalink: /connect/
title: Connect with us
description: Visit the Value Advisory Partners website or book a meeting with the team.
noindex: true
bare: true
eleventyExcludeFromCollections: true
---
<div class="vc">
  <div class="vc__top vc__top--hub">
    {% include "partials/connect-brand.njk" %}
    <section class="vc__id vc__id--hub">
      <h1 class="vc__headline"><span>Unlocking commercial</span> <span>potential to</span> <em>future proof value</em></h1>
    </section>
  </div>

  <div class="vc__sheet">
    <p class="vc__intro">{{ seo["/"].description }}</p>

    <div class="vc__cta">
      <a class="vc__btn vc__btn--primary" href="/" data-track="website_click">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
        Visit our website
      </a>
      <a class="vc__btn vc__btn--outline" href="/book/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
        Book a meeting
      </a>
    </div>

    <ul class="vc__tiles" style="--cols: 3" aria-label="Contact us">
      <li><a href="{{ site.phoneHref }}" aria-label="Call {{ site.phone }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>Call</a></li>
      <li><a href="mailto:{{ site.email }}" aria-label="Email {{ site.email }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>Email</a></li>
      <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="Value Advisory Partners on LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9.5V19M5 5.5v.01M10 19v-9.5M10 13.5c0-2.5 1.5-4 3.5-4s3.5 1.5 3.5 4V19"/></svg>LinkedIn</a></li>
    </ul>

    {% include "partials/connect-areas.njk" %}
  </div>
</div>
