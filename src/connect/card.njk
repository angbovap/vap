---
layout: base.njk
extraCss: /styles/connect.css
pagination:
  data: team
  size: 1
  alias: m
permalink: '/connect/{{ (m.name.split(" ") | first) | lower }}/'
eleventyExcludeFromCollections: true
noindex: true
bare: true
eleventyComputed:
  title: "{{ m.name }}"
  description: "{{ m.name }}, Value Advisory Partners. Save contact details or book a meeting."
---
{% set h = m.slug | bookHost %}
<div class="vc">
  {% include "partials/contours.njk" %}
  <div class="vc__screen">

    <header class="vc__brand">
      <img src="/assets/img/brand/vaplogo.png" alt="" width="36" height="36">
      <span class="vc__brand-name">{{ site.brandPrimary }} <span>{{ site.brandSecondary }}</span></span>
    </header>

    <section class="vc__id">
      <div class="vc__portrait">
        <span class="vc__photo" style="background-image: url('{{ m.image }}');" role="img" aria-label="Portrait of {{ m.name }}"></span>
      </div>
      <div class="vc__who">
        <h1 class="vc__name">{{ m.name }}</h1>
        {% if m.role %}<p class="vc__role">{{ m.role }}</p>{% endif %}
        <p class="vc__org">{{ site.name }}</p>
        <p class="vc__tagline">{{ site.tagline }}</p>
      </div>
    </section>

    <p class="vc__intro">{{ seo["/"].description }}</p>

    <div class="vc__cta">
      <a class="vc__btn vc__btn--primary" href="/connect/vcf/{{ m.slug }}.vcf" download data-save-contact="{{ m.slug }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg>
        Save my contact
      </a>
      {% if h %}<a class="vc__btn vc__btn--outline" href="{{ h.url }}" target="_blank" rel="noopener" data-book-host="{{ h.slug }}" data-book-focus="{{ h.focus }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
        Book a meeting
      </a>{% endif %}
    </div>

    <ul class="vc__tiles" aria-label="Contact {{ m.name }}">
      <li><a href="tel:{{ (m.phone or site.phone) | replace(' ', '') }}" aria-label="Call {{ m.phone or site.phone }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>Call</a></li>
      <li><a href="mailto:{{ m.email }}" aria-label="Email {{ m.email }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>Email</a></li>
      <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="Value Advisory Partners on LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9.5V19M5 5.5v.01M10 19v-9.5M10 13.5c0-2.5 1.5-4 3.5-4s3.5 1.5 3.5 4V19"/></svg>LinkedIn</a></li>
      <li><a href="/" data-track="website_click" aria-label="Visit the Value Advisory Partners website">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>Website</a></li>
    </ul>

    <section class="vc__areas" aria-labelledby="vc-areas">
      <h2 id="vc-areas">What we do</h2>
      <ul>
        {% for item in site.nav[1].children %}
        <li><a href="{{ item.url }}">{{ item.label.split(" ") | first | replace(",", "") }}</a></li>
        {% endfor %}
      </ul>
    </section>

    <footer class="vc__foot">{% for o in site.offices %}{{ o.locality }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</footer>

  </div>
</div>
