---
layout: base.njk
extraCss: /styles/connect.css
pagination:
  data: team
  size: 1
  alias: m
permalink: '/connect/{{ (m.name.split(" ") | first) | lower }}/'
eleventyExcludeFromCollections: true
noindex: true
bare: true
eleventyComputed:
  title: "{{ m.name }}'s business card"
  description: "Download {{ m.name }}'s Value Advisory Partners business card."
---
{% set first = (m.name.split(" ") | first) | lower %}
<div class="vc vc--card">
  <div class="vc__top">
    {% include "partials/connect-brand.njk" %}
    <section class="vc__showcase">
      <div class="vc__showcase-who visually-hidden">
        <h1 class="vc__name">{{ m.name }}</h1>
        {% if m.role %}<p class="vc__tagline">{{ m.role }}</p>{% endif %}
      </div>
      <img class="vc__bizcard" src="/assets/cards/{{ first }}.png" width="2100" height="1200" alt="Business card for {{ m.name }}{% if m.role %}, {{ m.role }}{% endif %}">
    </section>
  </div>

  <div class="vc__sheet">
    <div class="vc__cta">
      <a class="vc__btn vc__btn--primary" href="/assets/cards/{{ first }}.png" download="{{ m.name | replace(' ', '-') }}-business-card.png" data-track="card_download_png">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg>
        Download card
      </a>
      <a class="vc__btn vc__btn--outline" href="/assets/cards/{{ first }}.pdf" download="{{ m.name | replace(' ', '-') }}-business-card.pdf" data-track="card_download_pdf">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5"/></svg>
        Download PDF
      </a>
    </div>
    <p class="vc__alt">
      <a href="/connect/vcf/{{ m.slug }}.vcf" download data-save-contact="{{ m.slug }}">Save to contacts</a>
      <a href="/connect/">All business cards</a>
    </p>
  </div>
</div>
