---
layout: base.njk
extraCss: /styles/connect.css
pagination:
  data: team
  size: 1
  alias: m
permalink: '/connect/{{ (m.name.split(" ") | first) | lower }}/'
eleventyExcludeFromCollections: true
noindex: true
bare: true
eleventyComputed:
  title: "{{ m.name }}"
  description: "{{ m.name }}, Value Advisory Partners. Save contact details or book a meeting."
---
{% set h = m.slug | bookHost %}
{% set first = m.name.split(" ") | first %}
<div class="vc">
  <div class="vc__hero">
    {% include "partials/contours.njk" %}
    <div class="vc__inner">

      <header class="vc__brand">
        <img src="/assets/img/brand/vaplogo.png" alt="" width="40" height="40">
        <span class="vc__brand-name">{{ site.brandPrimary }} <span>{{ site.brandSecondary }}</span></span>
      </header>

      <section class="vc__id">
        <div class="vc__portrait">
          <span class="vc__photo" style="background-image: url('{{ m.image }}');" role="img" aria-label="Portrait of {{ m.name }}"></span>
        </div>
        <p class="vc__hello">Nice to meet you</p>
        <h1 class="vc__name">{{ m.name }}</h1>
        {% if m.role %}<p class="vc__role">{{ m.role }}</p>{% endif %}
        <p class="vc__org">{{ site.name }}</p>
      </section>

      <div class="vc__cta" data-vc-cta>
        <a class="vc__btn vc__btn--primary" href="/connect/vcf/{{ m.slug }}.vcf" download data-save-contact="{{ m.slug }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg>
          Save my contact
        </a>
        {% if h %}<a class="vc__btn vc__btn--glass" href="{{ h.url }}" target="_blank" rel="noopener" data-book-host="{{ h.slug }}" data-book-focus="{{ h.focus }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
          Book a meeting
        </a>{% endif %}
      </div>

    </div>
  </div>

  <div class="vc__inner vc__body">

    <p class="vc__intro">{{ seo["/"].description }}</p>

    <ul class="vc__stats" aria-label="Value Advisory Partners at a glance">
      <li><strong>130+</strong><span>projects</span></li>
      <li><strong>AU &amp; NZ</strong><span>across</span></li>
      <li><strong>{{ site.offices | length }}</strong><span>offices</span></li>
    </ul>

    <ul class="vc__links">
      <li><a href="tel:{{ (m.phone or site.phone) | replace(' ', '') }}">
        <i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></i>
        <span><em>Call</em>{{ m.phone or site.phone }}</span></a></li>
      <li><a href="mailto:{{ m.email }}">
        <i><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg></i>
        <span><em>Email</em>{{ m.email }}</span></a></li>
      <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener">
        <i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9.5V19M5 5.5v.01M10 19v-9.5M10 13.5c0-2.5 1.5-4 3.5-4s3.5 1.5 3.5 4V19"/></svg></i>
        <span><em>LinkedIn</em>Value Advisory Partners</span></a></li>
      <li><a href="/" data-track="website_click">
        <i><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg></i>
        <span><em>Website</em>valueadvisory.co</span></a></li>
    </ul>

    <section class="vc__areas" aria-labelledby="vc-areas">
      <h2 id="vc-areas">What we do</h2>
      <ol>
        {% for item in site.nav[1].children %}
        <li><a href="{{ item.url }}"><b>0{{ loop.index }}</b><span>{{ item.label }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a></li>
        {% endfor %}
      </ol>
    </section>

    <footer class="vc__foot">
      <a href="/connect/">Meet the rest of the team</a>
      <p>{% for o in site.offices %}{{ o.locality }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
    </footer>

  </div>

  <div class="vc__dock" data-vc-dock aria-hidden="true">
    <a class="vc__btn vc__btn--primary" href="/connect/vcf/{{ m.slug }}.vcf" download data-save-contact="{{ m.slug }}" tabindex="-1">Save contact</a>
    {% if h %}<a class="vc__btn vc__btn--glass" href="{{ h.url }}" target="_blank" rel="noopener" data-book-host="{{ h.slug }}" data-book-focus="{{ h.focus }}" tabindex="-1">Book a meeting</a>{% endif %}
  </div>
</div>
<script>
  // Show the bottom action bar once the main buttons have scrolled out of view.
  (function () {
    var cta = document.querySelector('[data-vc-cta]');
    var dock = document.querySelector('[data-vc-dock]');
    if (!cta || !dock || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (entries) {
      var out = !entries[0].isIntersecting;
      dock.classList.toggle('is-visible', out);
      dock.setAttribute('aria-hidden', out ? 'false' : 'true');
      Array.prototype.forEach.call(dock.querySelectorAll('a'), function (a) {
        a.tabIndex = out ? 0 : -1;
      });
    }).observe(cta);
  })();
</script>
