---
layout: base.njk
permalink: /publications/
title: Publications
extraCss: /styles/publications.css
---
{% set featuredList = publications | selectattr("featured") | sort(attribute="featured") %}
{% set talks = [] %}{% set reports = [] %}
{% for group in publications | groupByYear %}{% for item in group.items %}
  {% if item.type == "presentation" and not item.featured %}{% if talks.push(item) %}{% endif %}{% elif item.type == "report" %}{% if reports.push(item) %}{% endif %}{% endif %}
{% endfor %}{% endfor %}
{% set download %}<svg class="pubbtn__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>{% endset %}
{% set slidesIcon %}<svg class="pubbtn__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="1.5"/><path d="M8 21h8M12 17v4M10 8.5v5l4-2.5z"/></svg>{% endset %}

{% if featuredList.length %}
<section class="pubhero" id="featured" aria-labelledby="pubhero-heading">
  <div class="wrap">
    <div class="pubhero__top">
      <h1 class="pubhero__page" id="pubhero-heading">Talks and publications</h1>
    </div>

    {% set f = featuredList | first %}
      {% if f.titleMain %}{% set main = f.titleMain %}{% set sub = f.titleSub %}
      {% else %}{% set parts = f.title.split(": ") %}{% set main = parts[0] %}{% set sub = parts.slice(1).join(": ") %}{% endif %}
      {% set people = [] %}
      {% for name in (f.presenters or "").split(" and ") %}{% for m in team %}{% if m.name == name %}{% if people.push(m) %}{% endif %}{% endif %}{% endfor %}{% endfor %}
        <div class="pubhero__grid">
          <div class="pubhero__text">
            <p class="pubhero__kicker">Featured talk <span aria-hidden="true">·</span> {{ f.sortDate | monthYear }}</p>
            <h2 class="pubhero__title">{{ main }}</h2>
            {% if sub %}<p class="pubhero__subtitle">{{ sub }}</p>{% endif %}
            <div class="pubhero__who">
              {% if people.length %}
              <span class="pubhero__faces">{% for p in people %}<img class="pubhero__photo" src="{{ p.image }}" alt="" width="44" height="44">{% endfor %}</span>
              {% endif %}
              <p class="pubhero__whotext">
                {% if f.presenters %}<span class="pubhero__name">{{ f.presenters }}</span>{% endif %}
                <span class="pubhero__event">{{ f.event | replace("Presentation for ", "") }}{% if f.location %}, {{ f.location }}{% endif %}</span>
              </p>
            </div>
            <div class="pubhero__actions">
              {% if f.deck and f.slug %}<a class="pubbtn pubbtn--light" href="/publications/{{ f.slug }}/">{{ slidesIcon | safe }}View the presentation</a>
              {% elif f.links.download %}<a class="pubbtn pubbtn--light" href="{{ f.links.download }}">{{ download | safe }}Download the slides</a>{% endif %}
              {% if f.project %}<a class="pubbtn pubbtn--ghost-light" href="{{ f.project.url }}">View the project</a>{% endif %}
            </div>
          </div>

          {% if f.clips and f.clips.length %}
          {% set first = f.clips | first %}
          <div class="pubhero__media pubplayer" data-player>
            <div class="pubplayer__stage" data-player-stage>
              <video class="pubplayer__video" data-demo-video playsinline muted preload="none" poster="{{ first.poster }}" src="{{ first.video }}" aria-label="{{ first.label }}: {{ first.title }}"></video>
              <button type="button" class="pubplayer__toggle" data-player-toggle aria-label="Play">
                <span class="pubplayer__icon" aria-hidden="true"></span>
              </button>
              <button type="button" class="pubplayer__full" data-player-full aria-label="Full screen">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
              </button>
            </div>
            <ol class="pubtimeline">
              {% for clip in f.clips %}
              {% set t = clip.duration.split(":") %}
              <li style="flex-grow: {{ (t[0] | int) * 60 + (t[1] | int) }}">
                <button type="button" class="pubtimeline__seg{% if loop.first %} is-active{% endif %}" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-label="{{ clip.label }}: {{ clip.title }}" data-demo-src="{{ clip.video }}" data-demo-poster="{{ clip.poster }}">
                  <span class="pubtimeline__track"><span class="pubtimeline__fill" data-fill></span></span>
                  <span class="pubtimeline__label">{{ clip.label }}</span>
                </button>
              </li>
              {% endfor %}
            </ol>
          </div>
          {% elif f.links.presentationVideoId %}
          <div class="pubhero__media">
            <div class="pubplayer__stage pubplayer__stage--yt">
              <button class="wd-pub-video" type="button" data-yt-preview="{{ f.links.presentationVideoId }}" aria-label="Play video: {{ f.title }}">
                <img class="wd-pub-video__thumb" src="https://img.youtube.com/vi/{{ f.links.presentationVideoId }}/hqdefault.jpg" alt="" loading="lazy">
                <span class="pubplayer__icon" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          {% endif %}
        </div>
  </div>
</section>
{% else %}
<section class="pubhead">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Publications</p>
      <h1>Talks and publications</h1>
    </div>
  </div>
</section>
{% endif %}

{% if talks.length %}
<section class="pubtalks" aria-labelledby="pubtalks-title">
  <div class="wrap">
    <div class="pubsection__head">
      <h2 class="pubsection__title" id="pubtalks-title">More talks</h2>
    </div>
    <ul class="pubtalks__grid">
      {% for item in talks %}
      {% set videoId = item.links.presentationVideoId if item.links else "" %}
      <li class="pubcard reveal">
        <div class="pubcard__media">
          {% if videoId %}
          <button class="wd-pub-video" type="button" data-yt-preview="{{ videoId }}" aria-label="Play video: {{ item.title }}">
            <img class="wd-pub-video__thumb" src="https://img.youtube.com/vi/{{ videoId }}/hqdefault.jpg" alt="" loading="lazy">
            <span class="wd-pub-video__play" aria-hidden="true">▶</span>
          </button>
          {% elif item.clips and item.clips.length %}
          <img class="pubcard__img" src="{{ (item.clips | first).poster }}" alt="" loading="lazy">
          {% elif item.image %}
          <img class="pubcard__img" src="{{ item.image }}" alt="" loading="lazy">
          {% endif %}
        </div>
        <p class="pubcard__meta">{{ item.event | replace("Presentation for ", "") }}{% if item.location %}, {{ item.location }}{% endif %} <span aria-hidden="true">·</span> {{ item.sortDate | monthYear }}</p>
        <h3 class="pubcard__title">{{ item.title }}</h3>
        {% if item.presenters %}<p class="pubcard__by">Presented by {{ item.presenters }}</p>{% endif %}
        <div class="pubcard__links">
          {% if item.deck and item.slug %}<a class="pubbtn pubbtn--sm" href="/publications/{{ item.slug }}/">{{ slidesIcon | safe }}View the presentation</a>
          {% elif item.links.download %}<a class="pubbtn pubbtn--sm" href="{{ item.links.download }}">{{ download | safe }}Download the slides</a>{% endif %}
          {% if item.project %}<a class="pubbtn pubbtn--sm pubbtn--ghost" href="{{ item.project.url }}">View the project</a>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if reports.length %}
{% set series = (reports | first).series %}
<section class="pubreports" aria-labelledby="pubreports-title">
  <div class="wrap">
    <div class="pubsection__head">
      <h2 class="pubsection__title" id="pubreports-title">Research reports</h2>
      {% if series %}<p class="pubsection__intro">Published by CSIRO in the <em>{{ series }}</em> series, co-authored by Value Advisory Partners.</p>{% endif %}
    </div>
    <ol class="pubreports__list">
      {% for item in reports %}
      {% set au = item.authors | authorSummary %}
      <li class="pubreport reveal">
        <p class="pubreport__date">{{ item.sortDate | monthYear }}</p>
        <div class="pubreport__main">
          <h3 class="pubreport__title">{{ item.title | replace(": " ~ item.series, "") if item.series else item.title }}</h3>
          <p class="pubreport__by" title="{{ item.authors }}">{{ item.publisher }} <span aria-hidden="true">·</span> {{ au.count }} authors{% if au.ours.length %}, including {{ au.ours | join(" and ") }}{% endif %}</p>
        </div>
        {% if item.links.download %}<a class="pubbtn pubbtn--sm pubbtn--ghost pubreport__link" href="{{ item.links.download }}" aria-label="Read the report: {{ item.title }}">Read the report</a>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}

<script src="/scripts/publications-demo.js" defer></script>
