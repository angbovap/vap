---
layout: base.njk
pagination:
  data: go
  size: 1
  alias: key
permalink: "/go/{{ key }}/"
eleventyExcludeFromCollections: true
noindex: true
bare: true
title: Opening
---
{% set target = go[key].to + "?utm_source=" + key + "&utm_medium=qr&utm_campaign=" + go[key].campaign %}
<meta http-equiv="refresh" content="2;url={{ target }}">
<section class="vc vc--go">
  <div class="vc__screen">
    <p class="vc__go-note">Opening Value Advisory Partners&hellip;</p>
    <p><a class="vc__go-link" href="{{ target }}">Continue</a></p>
  </div>
</section>
<script>
  (function () {
    var target = {{ target | dump | safe }};
    var done = false;
    function go() { if (!done) { done = true; window.location.replace(target); } }
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'qr_scan', {
        go_slug: {{ key | dump | safe }},
        campaign: {{ go[key].campaign | dump | safe }},
        event_callback: go
      });
    }
    setTimeout(go, 600);
  })();
</script>
